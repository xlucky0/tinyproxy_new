#!/bin/sh
# shellcheck disable=SC1091,SC3043

. /lib/functions.sh

repair=0
case "$1" in
	'') ;;
	--fix) repair=1 ;;
	*)
		echo "Usage: tinyproxy-diagnose [--fix]" >&2
		exit 2
		;;
esac

config_load tinyproxy || {
	echo "ERROR: cannot read /etc/config/tinyproxy"
	exit 1
}

issues=0
instances=0
active_instances=0
repair_failed=0
used_ports=" "

valid_range() {
	local value="$1" minimum="$2" maximum="$3"
	case "$value" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "${#value}" -le 5 ] && [ "$value" -ge "$minimum" ] && [ "$value" -le "$maximum" ]
}

local_address() {
	local address="$1"
	ip -o address show 2>/dev/null | awk -v address="$address" '
		$3 == "inet" || $3 == "inet6" {
			split($4, parts, "/")
			if (parts[1] == address)
				found = 1
		}
		END { exit !found }
	'
}

next_free_port() {
	local candidate="$1"
	[ "$candidate" -ge 1024 ] || candidate=1024
	while [ "$candidate" -le 65535 ]; do
		case "$used_ports" in
			*" $candidate "*) candidate=$((candidate + 1)) ;;
			*) printf '%s' "$candidate"; return 0 ;;
		esac
	done
	return 1
}

set_option() {
	local section="$1" option="$2" value="$3"
	uci set "tinyproxy.$section.$option=$value" || return 1
	config_set "$section" "$option" "$value"
}

check_instance() {
	local section="$1" enabled port timeout max_clients listen bind
	config_get_bool enabled "$section" enabled 0
	config_get port "$section" port 8888
	config_get timeout "$section" timeout 600
	config_get max_clients "$section" max_clients 100
	config_get listen "$section" listen 127.0.0.1
	config_get bind "$section" bind
	instances=$((instances + 1))
	[ "$enabled" -eq 1 ] && active_instances=$((active_instances + 1))

	case "$section" in
		''|*[!a-zA-Z0-9_-]*)
			echo "ERROR: unsafe instance name"
			issues=$((issues + 1))
			[ "$repair" -eq 0 ] || repair_failed=1
			return
			;;
	esac
	if ! valid_range "$port" 1 65535; then
		echo "WARN: $section has an invalid port; safe default is 8888"
		issues=$((issues + 1))
		port=8888
		if [ "$repair" -eq 1 ]; then
			set_option "$section" port "$port" || {
				echo "ERROR: could not repair port for $section"
				repair_failed=1
				return 1
			}
		fi
	fi
	if [ "$enabled" -eq 1 ]; then
		case "$used_ports" in
			*" $port "*)
				echo "WARN: $section duplicates port $port"
				issues=$((issues + 1))
				if [ "$repair" -eq 1 ]; then
					port="$(next_free_port "$port")" || {
						echo "ERROR: no free port is available for $section"
						repair_failed=1
						return 1
					}
					set_option "$section" port "$port" || {
						echo "ERROR: could not assign a free port to $section"
						repair_failed=1
						return 1
					}
					echo "FIXED: assigned $section port $port"
				fi
				;;
		esac
		used_ports="${used_ports}${port} "
	fi
	if ! valid_range "$timeout" 1 86400; then
		echo "WARN: $section has an invalid timeout; safe default is 600"
		issues=$((issues + 1))
		if [ "$repair" -eq 1 ]; then
			set_option "$section" timeout 600 || {
				echo "ERROR: could not repair timeout for $section"
				repair_failed=1
				return 1
			}
		fi
	fi
	if ! valid_range "$max_clients" 1 10000; then
		echo "WARN: $section has invalid max_clients; safe default is 100"
		issues=$((issues + 1))
		if [ "$repair" -eq 1 ]; then
			set_option "$section" max_clients 100 || {
				echo "ERROR: could not repair max_clients for $section"
				repair_failed=1
				return 1
			}
		fi
	fi
	if [ -n "$listen" ] && [ "$listen" != 127.0.0.1 ] && [ "$listen" != 0.0.0.0 ] &&
		[ "$listen" != :: ] && ! local_address "$listen"; then
		echo "WARN: $section listen address is not assigned; runtime falls back to loopback"
		issues=$((issues + 1))
		if [ "$repair" -eq 1 ]; then
			set_option "$section" listen 127.0.0.1 || {
				echo "ERROR: could not repair listen address for $section"
				repair_failed=1
				return 1
			}
		fi
	fi
	if [ -n "$bind" ] && ! local_address "$bind"; then
		echo "WARN: $section bind address is not assigned; runtime ignores it"
		issues=$((issues + 1))
		if [ "$repair" -eq 1 ]; then
			uci -q delete "tinyproxy.$section.bind" || {
				echo "ERROR: could not repair bind address for $section"
				repair_failed=1
				return 1
			}
			config_set "$section" bind ""
		fi
	fi
	[ "$enabled" -eq 1 ] && echo "OK: $section enabled on configured port $port" ||
		echo "OK: $section disabled"
}

config_foreach check_instance tinyproxy
[ "$instances" -gt 0 ] || echo "WARN: no proxy instances configured"

check_service() {
	if [ "$active_instances" -eq 0 ]; then
		echo "WARN: no enabled proxy instances"
	elif /etc/init.d/tinyproxy status >/dev/null 2>&1; then
		echo "OK: Tinyproxy service is running"
	else
		echo "ERROR: Tinyproxy service is not running; inspect 'logread -e tinyproxy'"
		issues=$((issues + 1))
		[ "$repair" -eq 0 ] || repair_failed=1
	fi
}

if [ "$repair" -eq 1 ]; then
	[ "$repair_failed" -eq 0 ] || exit 1
	uci commit tinyproxy || exit 1
	echo "Regenerating protected runtime configs and restarting Tinyproxy..."
	/etc/init.d/tinyproxy restart || exit 1
	check_service
	[ "$repair_failed" -eq 0 ] || exit 1
	echo "Repair complete. Invalid settings were replaced with safe values in UCI."
	issues=0
elif [ "$issues" -gt 0 ]; then
	echo "Run 'tinyproxy-diagnose --fix' to repair safe numeric settings and duplicate ports."
fi

if [ "$repair" -eq 0 ]; then
	check_service
fi

[ "$issues" -eq 0 ]
